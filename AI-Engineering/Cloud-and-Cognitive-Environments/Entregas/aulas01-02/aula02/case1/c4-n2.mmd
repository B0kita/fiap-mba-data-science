C4Container
  title Case 1 · Ingestão de normas para RAG (C4 nível 2)

  Person(normas, "Time de normas", "Publica documentos novos ou atualizados")

  System_Boundary(qf, "Quantum Finance · Ingestão RAG (us-east-1)") {
    ContainerDb(s3docs, "Documentos originais", "Amazon S3 Standard", "PDFs com versionamento")
    Container(eb, "Disparo por evento", "Amazon EventBridge", "Regra Object Created")
    Container(ingestor, "Ingestor", "AWS Lambda (Python, 1 GB)", "Lê, quebra em trechos de 500 tokens, indexa")
    Container(titan, "Embeddings", "Bedrock · Titan Embed V2", "1.024 dimensões · cobra por token")
    ContainerDb(vec, "Base vetorial", "Amazon S3 Vectors", "Índice normas-idx · cobra por GB")
    ContainerQueue(dlq, "Fila de falhas", "Amazon SQS (DLQ)", "Documentos para reprocessar")
  }

  Rel(normas, s3docs, "Envia documento (upload)")
